<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bewerber – <%= job.title %> – LocalJobs.de</title>
<link rel="icon" href="/assets/img/logo-icon.svg">
<link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>

<%- include('../partials/header', { active: 'employer' }) %>

<main class="page-shell">
  <div class="container" style="max-width:820px">
    <a href="/employer/dashboard.html?companyId=<%= job.companyId %>" class="breadcrumb-back">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="15 18 9 12 15 6"/></svg>
      Dashboard
    </a>

    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:8px">
      <div>
        <h1 style="font-size:20px;font-weight:800"><%= job.title %></h1>
        <p style="color:var(--text-muted);font-size:13.5px"><%= applications.length %> Bewerber</p>
      </div>
      <a href="/job-details.html?id=<%= job.id %>" class="btn btn-outline btn-sm">Anzeige ansehen</a>
    </div>

    <% if (applications.length === 0) { %>
      <div class="empty-state">
        <p>Für diese Stelle liegen noch keine Bewerbungen vor.</p>
      </div>
    <% } else { %>
      <div class="panel">
        <% applications.forEach(app => { %>
          <div class="applicant-row" style="padding:16px 0">
            <div class="avatar" style="width:44px;height:44px"><img src="/assets/img/avatar-user.svg" alt=""></div>
            <div class="txt">
              <strong><%= app.applicant.firstName %> <%= app.applicant.lastName %></strong>
              <span><%= app.applicant.email %><% if (app.applicant.phone) { %> · <%= app.applicant.phone %><% } %></span>
              <span style="display:block;font-size:11.5px;color:var(--text-faint)">Beworben am <%= app.createdAt.toLocaleDateString('de-DE') %></span>
            </div>
            <a href="/cv/application.html?applicationId=<%= app.id %>" class="btn btn-primary btn-sm" target="_blank">Lebenslauf ansehen</a>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</main>

<script src="/assets/js/main.js"></script>
</body>
</html>
