<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Log In – LocalJobs.de</title>
<link rel="icon" href="/assets/img/logo-icon.svg">
<link rel="stylesheet" href="/assets/css/style.css">
</head>
<body class="no-bottom-pad" style="background:var(--bg)">

<%- include('../partials/header', { active: null }) %>

<main class="page-shell">
  <div class="container" style="max-width:440px">
    <div class="form-card">
      <h2 style="font-size:20px;margin-bottom:4px">Welcome Back</h2>
      <p style="color:var(--text-muted);font-size:14px;margin-bottom:20px">Log in to save jobs, apply, or post job listings.</p>

      <% if (error) { %>
        <div class="badge badge-yellow" style="display:block;padding:10px 14px;margin-bottom:16px;font-weight:600"><%= error %></div>
      <% } %>

      <form method="post" action="/login.html">
        <input type="hidden" name="next" value="<%= next %>">
        <div class="field-group">
          <label>Email*</label>
          <input type="email" name="email" required value="<%= email %>">
        </div>
        <div class="field-group">
          <label>Password*</label>
          <input type="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg">Log In</button>
      </form>

      <div class="form-foot">
        Don't have an account? <a href="/register.html<%= next ? '?next=' + encodeURIComponent(next) : '' %>" style="color:var(--primary);font-weight:700">Sign Up</a>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
<script src="/assets/js/main.js"></script>
</body>
</html>
