generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyType {
  PRIVATE
  PUBLIC
  GOVERNMENT
  LOCAL
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  createdAt    DateTime      @default(now())

  companies    Company[]
  cvProfile    CvProfile?
  applications Application[]
}

model Company {
  id             Int         @id @default(autoincrement())
  owner          User        @relation(fields: [ownerId], references: [id])
  ownerId        Int
  name           String
  contact        String
  email          String
  website        String?
  foundedDate    DateTime?
  totalEmployees Int?
  companyType    CompanyType
  country        String
  createdAt      DateTime    @default(now())

  jobs           Job[]

  @@index([ownerId])
}

model Job {
  id               Int           @id @default(autoincrement())
  company          Company       @relation(fields: [companyId], references: [id])
  companyId        Int
  title            String
  category         String
  employmentType   String
  country          String
  city             String?
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String        @default("EUR")
  description      String
  responsibilities String?
  requirements     String?
  createdAt        DateTime      @default(now())

  applications     Application[]

  @@index([companyId])
  @@index([country])
  @@index([category])
}

model Application {
  id          Int      @id @default(autoincrement())
  job         Job      @relation(fields: [jobId], references: [id])
  jobId       Int
  applicant   User     @relation(fields: [applicantId], references: [id])
  applicantId Int
  cvSnapshot  Json
  createdAt   DateTime @default(now())

  @@unique([jobId, applicantId])
  @@index([jobId])
  @@index([applicantId])
}

model CvProfile {
  id             Int            @id @default(autoincrement())
  user           User           @relation(fields: [userId], references: [id])
  userId         Int            @unique
  fullName       String?
  headline       String?
  summary        String?
  phone          String?
  email          String?
  address        String?
  templateChoice String         @default("template1")
  updatedAt      DateTime       @updatedAt

  experience     CvExperience[]
  education      CvEducation[]
  skills         CvSkill[]
  languages      CvLanguage[]
}

model CvExperience {
  id          Int       @id @default(autoincrement())
  cvProfile   CvProfile @relation(fields: [cvProfileId], references: [id], onDelete: Cascade)
  cvProfileId Int
  jobTitle    String
  company     String
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean   @default(false)
  description String?
  sortOrder   Int       @default(0)

  @@index([cvProfileId])
}

model CvEducation {
  id          Int       @id @default(autoincrement())
  cvProfile   CvProfile @relation(fields: [cvProfileId], references: [id], onDelete: Cascade)
  cvProfileId Int
  degree      String
  institution String
  startDate   DateTime?
  endDate     DateTime?
  description String?
  sortOrder   Int       @default(0)

  @@index([cvProfileId])
}

model CvSkill {
  id          Int       @id @default(autoincrement())
  cvProfile   CvProfile @relation(fields: [cvProfileId], references: [id], onDelete: Cascade)
  cvProfileId Int
  name        String
  level       Int       @default(3)

  @@index([cvProfileId])
}

model CvLanguage {
  id          Int       @id @default(autoincrement())
  cvProfile   CvProfile @relation(fields: [cvProfileId], references: [id], onDelete: Cascade)
  cvProfileId Int
  name        String
  level       String    @default("Good")

  @@index([cvProfileId])
}
